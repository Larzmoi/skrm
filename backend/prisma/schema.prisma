generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ShowStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum ProductStatus {
  PENDING
  RESERVED
  ACTIVE
  SOLD
  UNSOLD
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_SHIPPING_SELECTION
  PENDING_SHIPPING
  SHIPPED
  DELIVERED
  DISPUTED
  CANCELLED
}

// Fyysinen pakettikoko Postin lähetystä varten - EI sama asia kuin Order.shippingSize
// (toimitustapa postitus/nouto). Myyjän oma valinta poistettu 2026-09-11 (ks. CLAUDE.md) -
// kaikki lähetykset käyttävät nyt aina samaa kiinteää Posti-konfiguraatiota (ISO/PO2103, ainoa
// Postin curl-esimerkistä vahvistettu arvo), joten uusille tilauksille kirjoitetaan aina ISO.
// Enum jätetty schemaan siivoamatta - PIENI-arvo esiintyy yhä vanhoissa, ennen 2026-09-11
// luoduissa tilausriveissä eikä sitä ole syytä pudottaa historiadatan takia.
enum Pakettikoko {
  PIENI
  ISO
}

enum NotificationType {
  ORDER_WON
  ORDER_PAID
  ORDER_SHIPPED
  ORDER_DELIVERED
  PAYMENT_EXPIRED
  BAN_ISSUED
  MESSAGE
  SHIPPING_STALLED
  DELIVERY_REMINDER
  PAYMENT_RELEASED
  ORDER_AUTO_COMPLETED
  DISPUTE_OPENED
  OUTBID
  AUCTION_ENDED
  AUCTION_SOLD
  REVIEW_RECEIVED
  LISTING_REMOVED
  REFUND_ISSUED
  NEW_FOLLOWER
  SELLER_LIVE
  DELIVERY_CONFIRMED
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_DECLINED
  OFFER_COUNTERED
  ADMIN_LOST_PACKAGE_REVIEW
  ORDER_CANCELLED_BY_BUYER
  PICKUP_POINT_INACTIVE
  PICKUP_POINT_CHANGED
}

enum ReportStatus {
  PENDING
  REVIEWED
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String
  username         String   @unique
  avatarUrl        String?
  bio              String?
  phone            String?
  address          String?
  postalCode       String?
  city             String?
  businessId       String?
  usernameChangedAt DateTime?
  termsAcceptedAt   DateTime?
  privacyAcceptedAt DateTime?
  policyAcceptedAt  DateTime?
  vacationUntil    DateTime?
  vacationMessage  String?
  // Uutiskirjetilaus, ks. CLAUDE.md 2026-09-03 — profiilisivun kytkin, EI footerin (poistettu,
  // koska tilaajat ovat aina jo rekisteröityneitä käyttäjiä). Paikallinen kopio nopeaa lukua
  // varten, synkronoidaan Resendin Contacts-API:in joka muutoksella (ks. lib/resend.ts
  // syncNewsletterContact) — Resendin puoli on totuuden lähde varsinaista lähetystä varten.
  newsletterOptIn  Boolean  @default(false)
  streamKey        String?  @unique // pysyvä RTMP stream key — sama kaikissa myyjän lähetyksissä, ei per-Show
  livekitIngressId String?  // LiveKit Ingress-objektin ID (2026-08-09 migraatio MediaMTX:sta) — tarvitaan avaimen regeneroinnissa/poistossa. Huone on kiinteä "seller-{userId}", ei tallenneta erikseen koska on suoraan johdettavissa.
  // Admin-käyttäjähallinta (ks. CLAUDE.md/INTEGRATION.md 2026-09-02) — canStream oletuksena
  // false tarkoittaa että KAIKKI olemassa olevat käyttäjät (myös jo aiemmin streiganneet)
  // menettävät striimausoikeuden migraation jälkeen kunnes admin myöntää sen uudesta
  // /admin-paneelista — tarkoituksellista, se on koko ominaisuuden tarkoitus, mutta
  // omistajan oma tili pitää päivittää manuaalisesti heti migraation jälkeen ettei oma
  // testaus katkea. customCommissionRate/Cap ovat null = käytä oletusta (3,5%/35€,
  // ks. computeCommissionCents).
  canStream             Boolean  @default(false)
  customCommissionRate  Float?
  customCommissionCap   Float?
  role             Role     @default(USER)
  stripeCustomerId String?
  stripeAccountId  String?
  verified         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shows    Show[]
  products Product[]  @relation("SellerProducts")
  productPresets ProductPreset[]
  bids      Bid[]
  orders    Order[]    @relation("BuyerOrders")
  sales     Order[]    @relation("SellerOrders")
  followers Follower[] @relation("SellerFollowers")
  following Follower[] @relation("UserFollowing")
  carts             Cart[]
  paymentViolations PaymentViolation[]
  bans              Ban[]
  notifications     Notification[]
  sentMessages      Message[]          @relation("SentMessages")
  receivedMessages  Message[]          @relation("ReceivedMessages")
  autoBids          AutoBid[]
  currentBids       Product[]          @relation("CurrentBidder")
  reviewsGiven      Review[]           @relation("ReviewsGiven")
  reviewsReceived   Review[]           @relation("ReviewsReceived")
  reports           Report[]
  pushSubscriptions PushSubscription[]
  passwordResetTokens PasswordResetToken[]
  offers            Offer[]
}

// Salasanan palautuslinkin token (ks. CLAUDE.md "KRIITTINEN LÖYDÖS" / "Resend"). tokenHash on
// SHA-256-tiiviste raakatokenista - itse raakatoken kulkee vain sähköpostilinkissä, ei koskaan
// tietokannassa, jotta DB-vuoto ei suoraan antaisi valmiita palautuslinkkejä. usedAt estää saman
// linkin uudelleenkäytön; forgot-passwordin uusi pyyntö mitätöi aiemmat käyttämättömät tokenit.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Selaimen Web Push -tilaus (ks. CLAUDE.md "Push-ilmoitukset") - yksi rivi per selain/laite
// jolla käyttäjä on hyväksynyt ilmoitukset, ei per käyttäjä (sama käyttäjä voi olla
// kirjautuneena useammalla laitteella, kaikki saavat pushin).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Show {
  id            String     @id @default(cuid())
  title         String
  sellerId      String
  seller        User       @relation(fields: [sellerId], references: [id])
  status        ShowStatus @default(SCHEDULED)
  category      String?
  alakategoria  String?
  city          String?
  thumbnailUrl  String?
  hlsUrl        String? // HLS-toistolinkki katsojille — rakennettu myyjän pysyvästä User.streamKey:stä luontihetkellä
  scheduledAt   DateTime?
  startedAt     DateTime?
  endedAt       DateTime?
  viewerCount   Int        @default(0)
  mutedWords    String[]   @default([]) // kielletyt sanat chat-suodattimelle - persistoitu koska
                                          // socket.ts:n in-memory Map tyhjenee jokaisella backend-
                                          // uudelleenkäynnistyksellä (deploy), ks. CLAUDE.md
                                          // "Uudet löydökset 2026-08-13" kohta 2
  createdAt     DateTime   @default(now())

  products Product[]
  bids     Bid[]
}

model Product {
  id              String        @id @default(cuid())
  showId          String?
  show            Show?         @relation(fields: [showId], references: [id])
  sellerId        String
  seller          User          @relation("SellerProducts", fields: [sellerId], references: [id])
  name            String
  saleType        String        @default("live")
  description     String?
  imageUrl        String?
  category        String?
  alakategoria    String?
  tyyppi          String?       // kolmas kategoriataso — toistaiseksi vain Keräilykortit-kategorian peleillä (esim. "slabit"/"sealed"/"irtokortit")
  city            String?
  condition       String?
  // Gradattujen korttien oma kuntojärjestelmä (tyyppi === "slabit") — eri asia kuin `condition`
  // yllä, joka on tarkoitettu geneeriselle/Cardmarket-asteikolle. Ks. CLAUDE.md "WhatsApp-palaute
  // 2026-09-02" kohta 1 - priorisointi nostettu myyjäpalautteen myötä. Molemmat null muille tyypeille.
  gradingCompany  String? // esim. "PSA"/"BGS"/"CGC"/"SGC"/"Muu"
  grade           String? // esim. "9", "9.5", "10" - String eikä Float koska esim. "10 Black Label" -tyyppisiä erikoismerkintöjä esiintyy
  reverseHolo     Boolean       @default(false) // vain tyyppi "irtokortit" - ks. CLAUDE.md "WhatsApp-palaute 2026-09-02" kohta 1
  startPrice      Float
  reservePrice    Float?
  buyNowPrice     Float?
  finalPrice      Float?
  bidIncrement    Float?        // minimikorotus huudolle — oletus 1€ jos ei asetettu, myyjä voi asettaa pienemmänkin (esim. 0,10€)
  auctionDuration Int?          // live-lähetyksen huutokauppa-lotin kesto SEKUNTEINA — eri asia kuin perinteisen huutokaupan auctionEndsAt
  quantity        Int           @default(1)
  // Toimitustapa-rajoitukset — KORVAA vanhan pakollisen `pakettikoko` (postitus XOR nouto)
  // -kentän 2026-09-02 (ks. CLAUDE.md "Kaksi UX-löydöstä 2026-09-02" kohta 2). Oletus true
  // molemmille = ei rajoitusta, ostaja saa valita kumman tahansa checkoutissa. Myyjä voi
  // halutessaan rajata jommankumman pois valinnaisena lisäasetuksena tuotelomakkeessa.
  allowPickup     Boolean       @default(true)
  allowShipping   Boolean       @default(true)
  // Per-tuote ALV-sisältyvyysmerkintä yritysmyyjille (User.businessId asetettu) — LISÄTTY
  // 2026-09-10, ks. CLAUDE.md "ALV-toggle yritysmyyjille". Ennen tätä t.product.vatIncluded
  // -teksti näytettiin AINA kaikille yritysmyyjän tuotteille pelkän businessId:n perusteella,
  // mikä oli väärin — suurin osa myynnistä on käytettyä tavaraa (marginaaliverotus, ei ALV:tä
  // näkyviin ostajalle), vain satunnainen uusi tuote vaatii oikean ALV-sisältyvyysmerkinnän.
  // Oletus false (sama kuin ennen käytännössä oli useimmille tuotteille). Palvelinpuoli pakottaa
  // tämän aina falseksi jos myyjällä ei ole businessId:tä (ks. requireVerifiedSeller-lähellä
  // oleva tarkistus products.ts:ssä) — yksityismyyjä ei voi koskaan väittää hintansa sisältävän
  // ALV:tä, koska ei ole ALV-rekisteröity.
  vatIncluded     Boolean       @default(false)
  status          ProductStatus @default(PENDING)
  order           Int           @default(0)
  createdAt       DateTime      @default(now())

  // Perinteinen (ajastettu) huutokauppa — saleType "auction"
  auctionEndsAt   DateTime?
  currentBid      Float?
  currentBidderId String?
  currentBidder   User?         @relation("CurrentBidder", fields: [currentBidderId], references: [id])

  bids       Bid[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  messages   Message[]
  autoBids   AutoBid[]
  offers     Offer[]
}

// Myyjän omat pohjatuotteet livekäyttöön — ei itsessään myytävä Product, vain mallipohja
// (nimi/kunto/kategoria/kuva/kuvaus) josta live-konsolissa voi nopeasti luoda oikean Product-
// rivin täyttämällä vain otsikon+lähtöhinnan (kesto tulee jo olemassa olevasta huutokaupan
// aloitusnäkymästä, ks. CLAUDE.md "WhatsApp-palaute 2026-09-02" kohta 2, "Tuotteen syöttäminen
// kesken liven on liian hidasta"). Myyjällä voi olla satoja/tuhansia näitä (esim. koko
// korttivarasto ennakkoon luetteloituna) — siksi haku ja suosikkimerkintä listan kärkeen.
model ProductPreset {
  id           String    @id @default(cuid())
  sellerId     String
  seller       User      @relation(fields: [sellerId], references: [id])
  name         String
  condition    String?
  category     String?
  alakategoria String?
  tyyppi       String?
  imageUrl     String?
  description  String? // esim. Cardmarket-kommentista poimittu fyysinen sijainti ("Map T1")
  startPrice   Float?  // valinnainen oletuslähtöhinta - osa pohjista on tarkoituksella ilman kiinteää hintaa, ks. CLAUDE.md "Esiasetusten kolme löydöstä" kohta 1
  favorite     Boolean   @default(false)
  lastUsedAt   DateTime? // päivittyy kun pohjasta luodaan Product livessä - nostaa listan kärkeen
  createdAt    DateTime  @default(now())
}

model AutoBid {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  maxAmount Float
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

model Bid {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  showId    String? // null perinteisen (ei-live) huutokaupan huudoille
  show      Show?    @relation(fields: [showId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Float
  type      String   @default("manual") // "manual" | "auto"
  createdAt DateTime @default(now())
}

model Cart {
  id        String     @id @default(cuid())
  buyerId   String
  buyer     User       @relation(fields: [buyerId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  expiresAt DateTime   // 2h live-ostoille, ei expirya suoramyynnille
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  price     Float
  quantity  Int      @default(1)
  sellerId  String
  source    String   // "live" tai "direct"
  addedAt   DateTime @default(now())
}

model Order {
  id                String      @id @default(cuid())
  buyerId           String
  buyer             User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId          String
  seller            User        @relation("SellerOrders", fields: [sellerId], references: [id])
  items             OrderItem[]
  status            OrderStatus @default(PENDING_PAYMENT)
  productTotal      Float
  shippingPrice     Float?
  shippingSize      String?
  paytrailPaymentId String?     // viimeisimmän luodun maksun transactionId (yleiskäyttöön/lokitukseen)
  paytrailProductTxId String?   // tuotemaksun oma transactionId - erillinen shippingistä, tarvitaan kohdennettuun hyvitykseen
  paytrailShippingTxId String?  // toimitusmaksun oma transactionId
  paytrailAttemptId String?     // onnistuneen maksuyrityksen attemptId - tarvitaan rivikohtaisen
                                 // stampin ("{itemId}__{attemptId}") rekonstruointiin hyvityksessä,
                                 // koska sama itemId ei kelpaa stampiksi kahdesti (Paytrailin oma
                                 // toistosuoja, ks. lib/paytrail.ts createPayment())
                                 // Paytrail-kentät (yllä) jätetty koskematta vanhan datan säilymiseksi
                                 // (ks. CLAUDE.md "Paytrail -> Stripe") - eivät enää täyty uusilla
                                 // tilauksilla, korvattu alla olevilla Stripe-vastineilla.
  stripeSessionId       String? // Checkout Sessionin ID - luodaan POST /orders/:id/pay:ssa
  stripePaymentIntentId String? // PaymentIntentin ID, saadaan checkout.session.completed-webhookista.
                                 // Tarvitaan hyvityksiin (stripe.refunds.create({ payment_intent })).
  commissionCents       Int?    // Habahubin todellinen komissio-osuus SENTTEINÄ, tallennettu POST
                                 // /orders/:id/pay:ssa samalla hetkellä kun se lasketaan
                                 // application_fee_amount:ia varten (ks. lib/stripe.ts) - EI
                                 // laskettu uudelleen jälkikäteen, koska myyjän efektiivinen
                                 // komissioprosentti (14pv-promo/admin-ylikirjoitus) voi muuttua
                                 // ajan myötä eikä silloin enää vastaisi maksuhetkellä TODELLA
                                 // veloitettua summaa. Käytetään Tilitykset-sivun (dashboard/
                                 // tilitykset) rivikohtaiseen näyttöön - ks. CLAUDE.md.
  shippingWindowEnd DateTime?   // 6h yhdistämisikkuna
  paymentDeadline   DateTime?   // 2h maksuaika live-ostoille
  trackingCode      String?
  pickupCode        String?     // nouto-toimitustavan vahvistuskoodi — ostaja näyttää/kertoo tämän myyjälle fyysisessä noudossa
  pickupPointId     String?     // ostajan valitsema Postin noutopiste postitus-toimitustavalle (MOCK, ks. lib/postiService.ts)
  trackingNumber    String?     // Postin lähetyksen seurantanumero / parcels[].parcelNo — ks. CLAUDE.md "Posti"-osio,
                                 // 2026-09-04 alkaen OIKEA arvo OmaPosti Pro API v2:sta, ei enää mock
  postiShipmentId   String?     // OmaPosti Pro API:n lähetystunniste - eri asia kuin trackingNumber,
                                 // joka on yksittäisen paketin (parcels[]) oma numero
  pakettikoko       Pakettikoko? // myyjän lähetysvaiheessa valitsema fyysinen koko (ks. yllä enum-kommentti)
  sendingCode       String?     // Sending Code API:n koodi - EI VIELÄ KÄYTÖSSÄ (tuote-/roolirekisteröinti puuttuu
                                 // Postin puolelta, ks. CLAUDE.md), jää aina nulliksi kunnes se on kytketty
  labelUrl          String?     // MEIDÄN OMA proxy-URL (/api/orders/:id/label-pdf), EI Postin oma href - Postin
                                 // href vaatii Bearer+x-gateway-secret-headerit joita selain ei voi lähettää,
                                 // ks. CLAUDE.md "Posti"-osio 2026-09-04. Täsmälleen yksi sendingCode/labelUrl on
                                 // asetettu kerrallaan, ei koskaan molemmat.
  postiLabelHref    String?     // Postin OMA raaka prints[].href - EI KOSKAAN näytetä frontendille sellaisenaan,
                                 // vain backendin oma /label-pdf-proxy lukee tätä fetchLabelPdf()-kutsuun
  postiStatus       String?     // Postin toimitusseurannan tila: RECEIVED/IN_TRANSIT/AT_PICKUP_POINT/PICKED_UP (MOCK)
  shippedAt         DateTime?   // toimitusaikataulun (5/10/14pv) laskennan lähtöpiste
  stalledNotifiedAt DateTime?   // päivä 5 -ilmoitus lähetetty
  reminderNotifiedAt DateTime?  // päivä 10 -muistutus lähetetty
  deliveryConfirmedAt DateTime? // ostaja kuittasi vastaanoton - 48h tarkastusikkuna ennen automaattista maksun vapautumista (LUKITTU, ks. CLAUDE.md "Toimituksen aikataulu ja maksuturva")
  disputeReason     String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  reviews Review[]
}

model Review {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  reviewerId String
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  rating     Int // 1-5
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([orderId, reviewerId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  price     Float
  quantity  Int     @default(1)
  // true = rivi syntyi voitetusta huudosta/hyväksytystä tarjouksesta (lib/auctionOrder.ts
  // createOrderForAuctionWin - huutokaupan voitto, "osta heti" auktiotuotteelle, hyväksytty
  // tarjous, tai live-huudon voitto), false = tavallinen suoramyynti-/kori-osto (cart.ts
  // checkout). LUKITTU-sääntö "kaikki huudot sitovia — ei peruutuksia" koskee vain true-rivejä
  // - ostajan oma POST /orders/:id/cancel (ks. CLAUDE.md "Ostoskori/tilauksen peruutus")
  // tarkistaa tämän ja estää peruutuksen jos YKSIKIN tilauksen rivi on binding:true, koska
  // sama Order voi 6h-yhdistämisikkunan takia sisältää sekä sitovan että ei-sitovan rivin.
  binding   Boolean @default(false)
}

model PaymentViolation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String
  createdAt DateTime @default(now())
}

model Ban {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  reason    String
  endsAt    DateTime
  createdAt DateTime @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  reporter    User         @relation(fields: [reporterId], references: [id])
  targetType  String       // "product" | "show"
  targetId    String
  reason      String       // "prohibited" | "counterfeit" | "misleading" | "other"
  description String?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
}

model Follower {
  id         String   @id @default(cuid())
  sellerId   String
  seller     User     @relation("SellerFollowers", fields: [sellerId], references: [id])
  followerId String
  follower   User     @relation("UserFollowing", fields: [followerId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([sellerId, followerId])
}

// Etusivun mainostilan sisältö (ks. CLAUDE.md "Iso testauskierros 2026-09-04" kohta 6,
// muutettu karuselliksi 2026-09-11) - admin muokkaa /admin-paneelin "Mainos"-välilehdeltä
// ilman koodimuutosta. enabled=false piilottaa YKSITTÄISEN mainoksen etusivulta (muut
// enabled=true-mainokset pyörivät edelleen normaalisti karusellissa).
//
// Aiemmin tarkoituksella yksi kiinteä rivi (id aina "main", upsert), muutettu 2026-09-11
// omistajan pyynnöstä sallimaan useampi samanaikainen aktiivinen mainos jotka pyörivät
// automaattisesti (ks. frontend/app/page.tsx:n AdBanner) - id nyt tavallinen cuid, ei enää
// upsert-singleton. Vanha "main"-rivi säilyy tuotannossa ennallaan (id-arvo ei muutu
// jälkikäteen), näkyy nyt vain yhtenä listan monista mahdollisista mainoksista.
model AdSlot {
  id        String   @id @default(cuid())
  // Oletus false - uuden mainoksen luonti (POST /admin/ad) ei aktivoidu vahingossa julkiseksi
  // ennen kuin omistaja on oikeasti täyttänyt ja tallentanut sisällön.
  enabled   Boolean  @default(false)
  eyebrow   String   @default("")
  title     String   @default("")
  body      String   @default("")
  ctaText   String   @default("")
  ctaHref   String   @default("/huutokaupat")
  imageUrl  String?
  // Loopattava GIF/MP4 - LISÄTTY 2026-09-10, omistajan pyyntö. Base64 data-URL kuten imageUrl,
  // mutta EI koskaan resizeImage()-käsittelyn läpi (canvas+toDataURL tuhoaisi GIF-animaation ja
  // ei osaa käsitellä videotiedostoja ollenkaan) - tallennetaan sellaisenaan, admin-lomake
  // varoittaa/rajaa tiedostokokoa client-puolella sen sijaan. Kun asetettu, korvaa imageUrl:n
  // renderöinnissä (ei näytetä molempia yhtä aikaa) - ks. frontend/app/page.tsx:n AdBanner.
  videoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// "Tarjoa hintaa" -toiminto suoramyyntituotteille (ks. CLAUDE.md "Tarjoa hintaa — suoramyyntiin").
// Vain saleType "buy_now" - ei live/auction-tuotteille, koska niissä tarjoaminen tapahtuu jo
// huutamalla, tarjousmekanismi sekoittaisi huutokauppalogiikkaa. Useampi ostaja voi tarjota
// samaan tuotteeseen samanaikaisesti - ensimmäinen jonka myyjä hyväksyy voittaa, loput perutaan
// automaattisesti (ks. POST /offers/:id/accept).
model Offer {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  buyerId       String
  buyer         User      @relation(fields: [buyerId], references: [id])
  amount        Float
  status        String    @default("pending") // pending | accepted | declined | countered | expired
  counterAmount Float?
  createdAt     DateTime  @default(now())
  respondedAt   DateTime?
}
